{
  "Version": "1.5.0",
  "Author": "Ulanzi",
  "Name": "System Monitor",
  "Description": "CPU / Memory / Disk / Network monitor for D200",
  "Icon": "assets/icons/pluginIcon.png",
  "Category": "System Monitor",
  "CategoryIcon": "assets/icons/category.png",
  "CodePath": "dist/app.js",
  "Type": "JavaScript",
  "Inspect": "--inspect=127.0.0.1:9202",
  "PrivateAPI": true,
  "SupportedInMultiActions": false,
  "UUID": "com.ulanzi.ulanzistudio.sysmonitor",
  "Actions": [
    {
      "Name": "CPU Monitor",
      "Icon": "assets/icons/text.svg",
      "PropertyInspectorPath": "property-inspector/cpu/inspector.html",
      "state": 0,
      "States": [
        {
          "Image": "assets/icons/text.svg"
        }
      ],
      "Tooltip": "Show CPU usage with trend chart",
      "UUID": "com.ulanzi.ulanzistudio.sysmonitor.cpu",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "Devices": [
        "D200"
      ]
    },
    {
      "Name": "Memory Monitor",
      "Icon": "assets/icons/text.svg",
      "PropertyInspectorPath": "property-inspector/mem/inspector.html",
      "state": 0,
      "States": [
        {
          "Image": "assets/icons/text.svg"
        }
      ],
      "Tooltip": "Show memory usage with trend chart",
      "UUID": "com.ulanzi.ulanzistudio.sysmonitor.mem",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "Devices": [
        "D200"
      ]
    },
    {
      "Name": "Disk Active",
      "Icon": "assets/icons/text.svg",
      "PropertyInspectorPath": "property-inspector/disk/inspector.html",
      "state": 0,
      "States": [
        {
          "Image": "assets/icons/text.svg"
        }
      ],
      "Tooltip": "Show disk active time with trend chart",
      "UUID": "com.ulanzi.ulanzistudio.sysmonitor.disk",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "Devices": [
        "D200"
      ]
    },
    {
      "Name": "Disk IO",
      "Icon": "assets/icons/text.svg",
      "PropertyInspectorPath": "property-inspector/diskio/inspector.html",
      "state": 0,
      "States": [
        {
          "Image": "assets/icons/text.svg"
        }
      ],
      "Tooltip": "Show disk read and write rates",
      "UUID": "com.ulanzi.ulanzistudio.sysmonitor.diskio",
      "SupportedInMultiActions": false,
